#!/bin/sh
mkdir -p /tmp/mosdns
LOCK_DIR="/tmp/mosdns_hotplug.lock"
FLAG_FILE="/tmp/mosdns_hotplug_need_run.flag"
touch "$FLAG_FILE"
if ! mkdir "$LOCK_DIR" 2>/dev/null; then
	exit 0
fi
(
	while [ -f "$FLAG_FILE" ]; do
		rm -f "$FLAG_FILE"
		sleep 5
	done
	rmdir "$LOCK_DIR" 2>/dev/null
	localhost=$(uci get system.@system[0].hostname 2>/dev/null || echo "OpenWrt")
	real_lan=$(uci -q get network.lan.device || uci -q get network.lan.ifname || echo "br-lan")
	CACHE_FILE="/tmp/mosdns/neigh.cache"
	touch $CACHE_FILE 2>/dev/null
	EXPIRE_TIME=86400
	NOW=$(date +%s)
	INC_TMP=$(mktemp)
	ip addr show dev $real_lan 2>/dev/null | grep 'inet' | grep -v -E '::1/128|scope host' | awk '{print $2}' | cut -d'/' -f1 | while read -r ip; do
		echo "$ip $localhost $NOW" >> "$INC_TMP"
	done
	if [ -f "/tmp/odhcpd.leases" ]; then
		while read -r line; do
			echo "$line" | grep -q -E '^#|^$' && continue
			host=$(echo "$line" | awk '{print $4}')
			ips=$(echo "$line" | awk '{for(i=5;i<=NF;i++) printf $i" "}')
			for ip in $ips; do
				echo "$ip $host $NOW" >> "$INC_TMP"
			done
		done < /tmp/odhcpd.leases
	fi

	ip neigh show 2>/dev/null | grep -v 'FAILED' | while read -r line; do
		ip_addr=$(echo "$line" | awk '{print $1}')
		mac=$(echo "$line" | grep -oE 'lladdr [0-9a-fA-F:]{17}' | awk '{print $2}' | tr 'A-F' 'a-f')

		[ -z "$mac" ] && continue

		hostname=""
		if [ -f "/tmp/dhcp.leases" ]; then
			hostname=$(grep -i "$mac" /tmp/dhcp.leases | awk '{print $4}' | head -n 1)
		fi
		if [ -z "$hostname" ] && [ -f "$CACHE_FILE" ]; then
			hostname=$(grep -i "^${ip_addr} " "$CACHE_FILE" | awk '{print $2}' | head -n 1)
		fi

		hostname_lower=$(echo "$hostname" | tr 'A-Z' 'a-z')
		case "$hostname_lower" in
			""|"localhost"|"wpad")
				hostname="MAC-$(echo "$mac" | tr -d ':')"
				;;
		esac

		dev_name=$(echo "$line" | awk '{ for (i=1; i<NF; i++) { if ($i == "dev") print $(i+1); } }')
		luci_ip="$ip_addr"
		if echo "$luci_ip" | grep -qi "^fe80" && [ ! -z "$dev_name" ]; then
			luci_ip="${luci_ip}%${dev_name}"
		fi
		echo "$luci_ip $hostname $NOW" >> "$INC_TMP"
	done
	TMP_CACHE=$(mktemp)
	cat $CACHE_FILE "$INC_TMP" 2>/dev/null | awk -v n="$NOW" -v e="$EXPIRE_TIME" '
		BEGIN{n+=0;e+=0} {ts=$NF+0; if(NF>=3 && $1~/^[0-9a-fA-F:.]+(%[^ ]+)?$/ && (ts+e)>n) lines[$1]=$0} END{for(ip in lines) print lines[ip]}
	' | sort > $TMP_CACHE
	mv $TMP_CACHE $CACHE_FILE 2>/dev/null
	rm -f "$INC_TMP" 2>/dev/null
	cat $CACHE_FILE 2>/dev/null | awk '
	!/^#/ && NF>=2 {
		ip=$1; name=$2;
		gsub(/\.$/, "", name);
		if (tolower(name) == "localhost" || tolower(name) == "wpad") next;
		gsub(/%.*$/, "", ip);
		if (seen[ip]++) next;
		if (ip ~ /^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$/) {
			split(ip, arr, ".");
			ptr_name = arr[4]"."arr[3]"."arr[2]"."arr[1]".in-addr.arpa.";
			print name". 10 IN A "ip;
			print name".lan. 10 IN A "ip;
			print ptr_name" 10 IN PTR "name".lan.";
			next;
		}
		delete full; delete blocks;
		n = split(ip, blocks, ":");
		empty_idx = -1;
		for (i=1; i<=n; i++) { if (blocks[i] == "") { empty_idx = i; break; } }
		k = 0;
		for (i=1; i<=n; i++) {
			if (i == empty_idx) {
				missing = 8 - (n - 1);
				for (j=1; j<=missing; j++) full[++k] = "0000";
			} else {
				val = sprintf("%04s", blocks[i]);
				gsub(/ /, "0", val);
				full[++k] = val;
			}
		}
		hex_str = "";
		for (i=1; i<=8; i++) hex_str = hex_str full[i];
		ptr_name = "";
		for (i=length(hex_str); i>=1; i--) {
			char = tolower(substr(hex_str, i, 1));
			ptr_name = ptr_name char ".";
		}
		print name". 10 IN AAAA "ip;
		print name".lan. 10 IN AAAA "ip;
		print ptr_name"ip6.arpa. 10 IN PTR "name".lan.";
	}' > /tmp/mosdns/lan.zone
) &
